  portainer:
    image: portainer/portainer-ce:latest
    container_name: portainer
    restart: unless-stopped
    command:
      - --admin-password
      - "{{ portainer_admin_password_hash | replace('$', '$$') }}"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - "{{ penzance_data_root }}/config/portainer:/data"
    networks:
      - edge
