@cli.group("runtime")
def runtime_group() -> None:
    """Manage pass-backed runtime SSH keys and Terraform state."""


@runtime_group.command("import")
def runtime_import() -> None:
    """Store current runtime SSH keys and Terraform state in pass."""
    imported = import_runtime_to_pass()
    for entry in imported:
        click.echo(f"stored: {entry}")
    if not imported:
        click.echo("nothing to store")


@runtime_group.command("restore")
@click.option("--require-state", is_flag=True, help="Fail if Terraform state is not present in pass.")
def runtime_restore(require_state: bool) -> None:
    """Hydrate /tmp/homelab from pass."""
    restore_runtime_from_pass(require_ssh=True, require_terraform_state=require_state, restore_terraform_state=True)
    click.echo(f"restored runtime cache: {RUNTIME_DIR}")


@runtime_group.command("save-state")
def runtime_save_state() -> None:
    """Store the current Terraform state cache in pass."""
    saved = save_terraform_state_to_pass()
    for entry in saved:
        click.echo(f"stored: {entry}")
    if not saved:
        raise click.ClickException(f"no Terraform state found at {TERRAFORM_STATE_PATH}")


@runtime_group.command("status")
def runtime_status() -> None:
    """Show whether runtime cache files are present without printing secrets."""
    config = load_config()
    restore_candidates = expected_ssh_key_paths(config)
    click.echo(f"pass runtime prefix: {PASS_RUNTIME_PREFIX}")
    click.echo(f"runtime cache: {RUNTIME_DIR}")
    for path in restore_candidates:
        marker = "ok" if path.exists() else "missing"
        click.echo(f"{marker:7} {path}")
    for path in [TERRAFORM_STATE_PATH, TERRAFORM_STATE_BACKUP_PATH]:
        marker = "ok" if path.exists() else "missing"
        click.echo(f"{marker:7} {path}")


@cli.command("paths")
def paths() -> None:
    data = {
        "root_dir": str(ROOT_DIR),
        "runtime_dir": str(RUNTIME_DIR),
        "pass_store_dir": str(PASS_STORE_DIR),
        "pass_runtime_prefix": PASS_RUNTIME_PREFIX,
        "inventory_path": str(INVENTORY_PATH),
        "group_vars_path": str(GROUP_VARS_PATH),
        "terraform_vars_path": str(TFVARS_PATH),
        "terraform_state_path": str(TERRAFORM_STATE_PATH),
        "config_path": str(CONFIG_PATH),
        "ssh_keys_dir": str(SSH_KEYS_DIR),
    }
    click.echo(json.dumps(data, indent=2))


@cli.command("debug-cloudflare-ids")
def debug_cloudflare_ids() -> None:
    """Print live Cloudflare IDs needed for state import."""
    restore_runtime_from_pass(require_ssh=True, require_terraform_state=not TERRAFORM_STATE_PATH.exists())
    render_config_files()
    run(["terraform", "apply", "-refresh-only", "-auto-approve", "-lock=false"], cwd=TERRAFORM_DIR)
    outputs = run(["terraform", "output", "-json"], cwd=TERRAFORM_DIR, capture_output=True)
    click.echo(outputs.stdout.strip())


if __name__ == "__main__":
    cli()
