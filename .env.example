DOMAIN=towerundersiege.com
ACME_EMAIL=info@towerundersiege.com
TZ=Europe/London

# Local storage layout.
CONFIG_ROOT=/var/lib/homelab/config
FILES_ROOT=/srv
MEDIA_ROOT=/srv/media
SYNC_ROOT=/srv/sync
PUID=1000
PGID=2100
SERVICE_USER=ryan
SERVICE_GROUP=homelab
SERVICE_GROUP_GID=2100

# Set this to the host's Tailscale IPv4 address so internal HTTPS only binds
# to Tailscale. Leave unset to bind Caddy to localhost only.
TAILSCALE_IP=

# Required by Caddy DNS-01 certificate issuance.
CLOUDFLARE_API_TOKEN=

# Required by cloudflared. Public ingress for jellyfin/navidrome is configured
# in Cloudflare Zero Trust, not in this repo.
CLOUDFLARED_TUNNEL_TOKEN=
